# Sarvam AI API Key (get from dashboard.sarvam.ai → API Keys)
SARVAM_API_KEY=sk_your_key_here

# Email alerts for escalations (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=alerts@yourapp.com

# Webhook for escalation alerts (optional)
ESCALATION_WEBHOOK_URL=

# Exotel telephony (required for real phone calls)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=

# Public URL of this server (ngrok or VPS — for Exotel callbacks)
PUBLIC_URL=https://your-ngrok-url.ngrok.io
